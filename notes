CREATE TABLE IF NOT EXISTS Bronze.customer (
            customer_id VARCHAR(32),
            customer_unique_id VARCHAR(32),
            customer_zip_code_prefix INTEGER,
            customer_city VARCHAR(32),
            customer_state VARCHAR(2),
            partition_key VARCHAR(6)
        ) PARTITION BY LIST (partition_key);

CREATE TABLE IF NOT EXISTS Bronze.customer (
            customer_id VARCHAR(32),
            customer_unique_id VARCHAR(32),
            customer_zip_code_prefix INTEGER,
            customer_city VARCHAR(32),
            customer_state VARCHAR(2),
            partition_key VARCHAR(6)
        ) PARTITION BY LIST (partition_key);

CREATE TABLE bronze.metadata_config (
    table_name VARCHAR(32),
    last_extracxt_date TIMESTAMP DEFAULT '2016-08-01 00:00:00',
    tbl_query TEXT,
    duration INTEGER DEFAULT 1,
    duration_type VARCHAR(10) DEFAULT 'DAY'
);


INSERT INTO bronze.metadata_config (table_name,duration_type) VALUES ('customer','MONTH');


