                                       ( 9,1,'is_latest','BOOLEAN',9,FALSE,FALSE,FALSE,FALSE,NULL);

UPDATE silver.table_column_config
SET is_scd2_column = FALSE
WHERE column_config_id = 9 AND config_id = 1;


