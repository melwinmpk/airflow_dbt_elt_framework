CREATE TABLE silver.table_load_config (
    config_id BIGSERIAL PRIMARY KEY,
    source_schema VARCHAR(100) NOT NULL,
    source_table VARCHAR(200) NOT NULL,
    target_schema VARCHAR(100) NOT NULL,
    target_table VARCHAR(200) NOT NULL,
    extract_date_column VARCHAR(200),
    load_type VARCHAR(20) NOT NULL
        CHECK (load_type IN ('FULL', 'INCREMENTAL')),
    scd_type SMALLINT NOT NULL
        CHECK (scd_type IN (0, 1, 2)),
    hash_column_name VARCHAR(200),
    source_filter TEXT,
    is_active BOOLEAN DEFAULT TRUE,
    created_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    modified_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uk_source_target
    UNIQUE (
        source_schema,
        source_table,
        target_schema,
        target_table
    )
);

CREATE TABLE silver.table_column_config (
    column_config_id BIGSERIAL PRIMARY KEY,
    config_id BIGINT NOT NULL,
    column_name VARCHAR(200) NOT NULL,
    data_type VARCHAR(100) NOT NULL,
    ordinal_position INTEGER NOT NULL,
    nullable BOOLEAN DEFAULT TRUE,
    is_primary_key BOOLEAN DEFAULT FALSE,
    is_scd2_column BOOLEAN DEFAULT FALSE,
    is_audit_column BOOLEAN DEFAULT FALSE,
    default_value VARCHAR(500),
    is_active BOOLEAN DEFAULT TRUE,
    created_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_table_column_config
        FOREIGN KEY (config_id)
        REFERENCES silver.table_load_config(config_id)
);


INSERT INTO silver.table_load_config (
config_id,source_schema,source_table,target_schema,target_table,extract_date_column,load_type,scd_type,hash_column_name,source_filter
) 
VALUES (1,'bronze','sellers','silver','dim_sellers','partition_key','INCREMENTAL','2','record_hash','partition_key');

INSERT INTO silver.table_column_config ( column_config_id,config_id,column_name,data_type,ordinal_position,nullable,is_primary_key,is_scd2_column,is_audit_column,default_value ) 
VALUES                                 ( 1,1,'seller_id','VARCHAR',1,FALSE,TRUE,TRUE,FALSE,NULL),
                                       ( 2,1,'seller_zip_code_prefix','INTEGER',2,FALSE,FALSE,TRUE,FALSE,NULL),
